+# DecoVAE patch: read the Phase 3 latent cache, which is .npy.
+#
+# scripts/extract_3d_meddiff_latents.py writes one float32 .npy per subject, shape
+# [C=8, D, H, W], because the pooled corpus is itself a .npy cache and round-tripping
+# through NIfTI would cost a conversion pass over 52k volumes for nothing. Upstream
+# globs '*.nii.gz' and loads with torchio, so without this the dataset silently finds
+# zero files and __init__ raises on file_paths[0].
+#
+# Two upstream behaviours are kept deliberately:
+#   - the `_latents` suffix appended to each json value, so the json names the BASE
+#     directory and the latents live in <base>_latents;
+#   - the json KEY as the conditioning class index, which is what lets the pooled run
+#     condition on modality (0=T1, 1=T2, 2=FLAIR) and therefore be comparable to our
+#     per-modality gFID slices at all.
 import numpy as np
 import torch
 from torch.utils.data.dataset import Dataset
